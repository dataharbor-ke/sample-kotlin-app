<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Header Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/fdis_subtitle"
        android:textAlignment="center"
        android:textColor="#666666"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_sms_permission_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#FFF3CD"
        android:padding="16dp"
        android:text="@string/sms_permission_banner_text"
        android:textColor="#664D03"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/btn_sms_permission_banner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle" />

    <Button
        android:id="@+id/btn_sms_permission_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:backgroundTint="#E0A800"
        android:text="@string/sms_permission_banner_action"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_sms_permission_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_sms_permission_banner" />

    <!-- Default Dialog Button -->
    <Button
        android:id="@+id/btn_default_dialog"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/default_dialog"
        android:layout_marginTop="24dp"
        android:backgroundTint="#2A73FF"
        android:textColor="#FFFFFF"
        android:paddingVertical="12dp"
        android:elevation="2dp"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_sms_permission_banner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Custom Dialog Button -->
    <Button
        android:id="@+id/btn_custom_dialog"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/start_with_custom_dialog"
        android:layout_marginTop="16dp"
        android:backgroundTint="#00B894"
        android:textColor="#FFFFFF"
        android:paddingVertical="12dp"
        android:elevation="2dp"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/btn_default_dialog"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_clear_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#5A5A5A"
        android:elevation="2dp"
        android:paddingVertical="12dp"
        android:text="@string/clear_sdk_data"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_custom_dialog" />

    <!-- Footer note -->
    <TextView
        android:id="@+id/tv_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_footer"
        android:textColor="#999999"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
